      "cell_type": "markdown",
      "source": [
        "# Feature Processing & Emotion Summarization\n",
        "\n",
        "This code loads the CMU-MOSEI dataset from a .pkl file, cleans invalid values, calculates the energy across modalities, and generates an emotional summary for each sample through four main steps:\n",
        "\n",
        "* **Data Loading & Value Cleaning:** Reads the pickle file and replaces invalid numerical values (NaN or Inf) in visual (face), acoustic (audio), and text (text) features with 0, while ensuring each label standardizes to 7 dimensions.\n",
        "\n",
        "* **Sentiment & Emotion Classification:** Uses the first label dimension to determine overall sentiment (positive, negative, or neutral) and identifies strong specific emotions (e.g., happy, sad, anger) when any of the remaining 6 dimensions exceed 0.5.\n",
        "\n",
        "* **Modality Energy Calculation:** Computes feature energy levels for the visual, acoustic, and textual modalities using vector norms (np.linalg.norm).\n",
        "\n",
        "* **Formatted Summary Output:** Combines sentiment tendencies, active emotions, and three-modality energy metrics into readable sentences, printing the processed results for the first 8 samples."
      ],
      "metadata": {
        "id": "Kv69TBppn3UL"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pickle\n",
        "import numpy as np\n",
        "\n",
        "with open(\"/Users/ting-yenwang/Downloads/CMU-MOSEI/multimodal_30samples.pkl\", \"rb\") as f:\n",
        "    data = pickle.load(f)\n",
        "\n",
        "print(f\"Total multimodal samples: {len(data)}\\n\")\n",
        "\n",
        "emotion_names = ['sentiment', 'happy', 'sad', 'anger', 'surprise', 'disgust', 'fear']\n",
        "\n",
        "def clean_features(feat):\n",
        "    \"\"\"Clean NaN and Inf values\"\"\"\n",
        "    feat = np.array(feat, dtype=np.float64)\n",
        "    feat = np.nan_to_num(feat, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "    return feat\n",
        "\n",
        "def get_clean_label(label):\n",
        "    \"\"\"Ensure label has 7 dimensions\"\"\"\n",
        "    label = np.array(label).flatten()\n",
        "    if len(label) >= 7:\n",
        "        return label[:7]          # Take the first 7 dimensions\n",
        "    else:\n",
        "        # Pad with zeros if less than 7\n",
        "        padded = np.zeros(7)\n",
        "        padded[:len(label)] = label\n",
        "        return padded\n",
        "\n",
        "def describe_sample(sample):\n",
        "    face  = clean_features(sample['face'])\n",
        "    audio = clean_features(sample['audio'])\n",
        "    text  = clean_features(sample['text'])\n",
        "    label = get_clean_label(sample['label'])\n",
        "\n",
        "    sentiment = label[0]\n",
        "\n",
        "    # Sentiment tendency\n",
        "    if sentiment >= 1.0:\n",
        "        sent = \"clearly positive\"\n",
        "    elif sentiment >= 0.3:\n",
        "        sent = \"slightly positive\"\n",
        "    elif sentiment <= -1.0:\n",
        "        sent = \"clearly negative\"\n",
        "    elif sentiment <= -0.3:\n",
        "        sent = \"slightly negative\"\n",
        "    else:\n",
        "        sent = \"neutral\"\n",
        "\n",
        "    # Active emotions\n",
        "    active = []\n",
        "    for i, name in enumerate(emotion_names[1:], 1):\n",
        "        if label[i] > 0.5:\n",
        "            active.append(f\"{name}({label[i]:.2f})\")\n",
        "    emo_str = \", \".join(active) if active else \"no strong specific emotion\"\n",
        "\n",
        "    # Multimodal energy (cleaned)\n",
        "    face_energy  = np.linalg.norm(face)\n",
        "    audio_energy = np.linalg.norm(audio)\n",
        "    text_energy  = np.linalg.norm(text)\n",
        "\n",
        "    desc = (f\"The speaker shows a {sent} sentiment with {emo_str}. \"\n",
        "            f\"[Face energy: {face_energy:.1f} | Audio energy: {audio_energy:.1f} | Text energy: {text_energy:.1f}]\")\n",
        "\n",
        "    return desc, label\n",
        "\n",
        "# Display the first 8 samples\n",
        "for i, sample in enumerate(data[:8]):\n",
        "    desc, clean_label = describe_sample(sample)\n",
        "    print(f\"[{i+1}] ID: {sample['id']}\")\n",
        "    print(f\"    Clean Label: {np.round(clean_label, 3)}\")\n",
        "    print(f\"    {desc}\")\n",
        "    print()"
      ],
      "metadata": {
